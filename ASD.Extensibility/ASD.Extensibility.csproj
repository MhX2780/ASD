<Project Sdk="Microsoft.NET.Sdk">
  <!-- The contract between ASD and its extensions. ASD ships its own copy; an extension must NOT ship this DLL. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ASD.Extensibility</RootNamespace>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260508005" />
  </ItemGroup>
</Project>
