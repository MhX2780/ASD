<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ASD</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableImplicitUsings>true</EnableImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationTitle>ASD</ApplicationTitle>
    <ApplicationDisplayVersion>1.3.0</ApplicationDisplayVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <!--
    Two ways to build ASD:
      normal  = a plain folder (unpackaged), what CI tests and zips;
      AsdMsix = the installed app: an MSIX package. The "msix" job passes /p:AsdMsix=true.
    These settings live HERE (not on the msbuild command line) because a command-line property would also
    reach ASD.Extensibility, a plain class library that cannot be packaged.
  -->
  <PropertyGroup Condition="'$(AsdMsix)' != 'true'">
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AsdMsix)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <AsdExtensibilityDll Condition="'$(AsdExtensibilityDll)' == ''">$(MSBuildProjectDirectory)\ASD.Extensibility\bin\x64\Release\net8.0-windows10.0.19041.0\ASD.Extensibility.dll</AsdExtensibilityDll>
  </PropertyGroup>

  <ItemGroup>
    <!-- app.ico is copied next to ASD.exe: AppWindow.SetTaskbarIcon needs a real file path -->
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- brand logos for the Keys Store (Simple Icons, CC0) -->
    <Content Include="Assets\simple-icons.json.gz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\SplashIcon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Cursors\**\*.cur">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Cursors\**\*.ani">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- the contract between ASD and its extensions (a separate DLL, because an extension is compiled against it) -->
    <Compile Remove="ASD.Extensibility\**" />
    <EmbeddedResource Remove="ASD.Extensibility\**" />
    <None Remove="ASD.Extensibility\**" />
  </ItemGroup>

  <!-- normal build: a project reference. MSIX build: the contract DLL built by the step before (a project reference makes the
       MSIX resource step look for a .pri file this plain library does not have). -->
  <ItemGroup Condition="'$(AsdMsix)' != 'true'">
    <ProjectReference Include="ASD.Extensibility\ASD.Extensibility.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(AsdMsix)' == 'true'">
    <Reference Include="ASD.Extensibility">
      <HintPath>$(AsdExtensibilityDll)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- the installer (ASD.Setup) is its own project, built by its own CI step: keep its files out of ASD -->
    <Compile Remove="ASD.Setup\**" />
    <Page Remove="ASD.Setup\**" />
    <EmbeddedResource Remove="ASD.Setup\**" />
    <Content Remove="ASD.Setup\**" />
    <None Remove="ASD.Setup\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- package logos, used only when ASD is built as an MSIX -->
    <Content Include="Assets\Package\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260508005" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
  </ItemGroup>

</Project>
