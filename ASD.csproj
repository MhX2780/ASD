<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ASD</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableImplicitUsings>true</EnableImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationTitle>ASD</ApplicationTitle>
    <ApplicationDisplayVersion>1.3.0</ApplicationDisplayVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <!-- app.ico is copied next to ASD.exe: AppWindow.SetTaskbarIcon needs a real file path -->
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- brand logos for the Keys Store (Simple Icons, CC0) -->
    <Content Include="Assets\simple-icons.json.gz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\SplashIcon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Cursors\**\*.cur">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Cursors\**\*.ani">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- the contract between ASD and its extensions (a separate DLL, because an extension is compiled against it) -->
    <Compile Remove="ASD.Extensibility\**" />
    <EmbeddedResource Remove="ASD.Extensibility\**" />
    <None Remove="ASD.Extensibility\**" />
    <ProjectReference Include="ASD.Extensibility\ASD.Extensibility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the installer (ASD.Setup) is its own project, built by its own CI step: keep its files out of ASD -->
    <Compile Remove="ASD.Setup\**" />
    <Page Remove="ASD.Setup\**" />
    <EmbeddedResource Remove="ASD.Setup\**" />
    <Content Remove="ASD.Setup\**" />
    <None Remove="ASD.Setup\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- package logos, used only when ASD is built as an MSIX -->
    <Content Include="Assets\Package\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260508005" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
  </ItemGroup>

</Project>
