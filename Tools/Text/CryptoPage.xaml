<Page
    x:Class="ASD.CryptoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid Padding="32" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Encrypt / Decrypt (AES-256)" FontSize="26" FontWeight="Bold"/>

        <TextBlock Grid.Row="1" Opacity="0.7" TextWrapping="Wrap"
                   Text="Real AES-256-CBC encryption. The password is turned into a key using PBKDF2 with a random salt, so the same text encrypted twice will look different — that's expected and correct."/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="Password:" VerticalAlignment="Center"/>
            <PasswordBox x:Name="PasswordBox" Width="240" PlaceholderText="Enter a password"/>
            <Button Content="Encrypt" Click="OnEncryptClick" Style="{StaticResource AccentButtonStyle}"/>
            <Button Content="Decrypt" Click="OnDecryptClick"/>
            <Button Content="Clear" Click="OnClearClick"/>
        </StackPanel>

        <TextBox x:Name="InputBox" Grid.Row="3" PlaceholderText="Plain text to encrypt, or Base64 cipher text to decrypt..."
                 AcceptsReturn="True" TextWrapping="Wrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Result:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <Button Content="Copy" Click="OnCopyClick"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.7"/>
        </StackPanel>

        <TextBox x:Name="OutputBox" Grid.Row="5" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Page>
