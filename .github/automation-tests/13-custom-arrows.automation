automation: custom arrows
cell a:
  run: echo token-found & exit 2
  exit 2 -> two | color orange | name Two
  exit 3 -> three
  failure contains TOKEN -> found | color #8B5CF6 | name Found it
  failure contains nothing-like-this -> missing
  always exit 2 contains token when cmd /c exit 0 -> combo | color #14B8A6
  success -> never
cell two:
  run: echo ran-two
cell three:
  run: echo SHOULD-NOT-RUN-3
cell found:
  run: echo ran-found
cell missing:
  run: echo SHOULD-NOT-RUN-M
cell combo:
  run: echo ran-combo
cell never:
  run: echo SHOULD-NOT-RUN-N
