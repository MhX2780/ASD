automation: status cell
cell a:
  run: echo from-a & exit 3
  always -> check
cell check:
  status: incoming
  exit 0 -> zero
  exit 3 -> three | name Code three
  otherwise -> other
cell zero:
  run: echo SHOULD-NOT-RUN-ZERO
cell three:
  run: echo ran-three
cell other:
  run: echo SHOULD-NOT-RUN-OTHER
