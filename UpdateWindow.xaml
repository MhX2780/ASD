<Window
    x:Class="ASD.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ASD Update">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="36,24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Spacing="16">

            <!-- Visual: progress ring → Windows "update" icon (or a result icon) -->
            <Grid Height="112" HorizontalAlignment="Center" Width="112">
                <ProgressRing x:Name="Ring" IsActive="True" Width="64" Height="64"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <FontIcon x:Name="StatusIcon" FontSize="64" Visibility="Collapsed"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="TitleText" Text="Checking…" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

            <TextBlock x:Name="DetailText" Opacity="0.75" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" MaxWidth="420" IsTextSelectionEnabled="True"/>

            <!-- Linear progress (download / extract / install) -->
            <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" MaxWidth="420"/>
            <TextBlock x:Name="StatsText" Opacity="0.7" FontSize="12" TextAlignment="Center"
                       HorizontalAlignment="Center" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <Button x:Name="RetryButton" Content="Try again" Style="{StaticResource AccentButtonStyle}"
                        Visibility="Collapsed" Click="OnRetryClick"/>
                <Button x:Name="CloseButton" Content="Close" Visibility="Collapsed" Click="OnCloseClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
