<Application
    x:Class="ASD.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ASD"
    RequestedTheme="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Mica: pages/windows must not paint an opaque background over the backdrop -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="Transparent"/>

            <!-- Navigation: transparent backgrounds -->
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
