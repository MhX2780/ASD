<Window
    x:Class="ASD.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ASD"
    Title="ASD">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />   <!-- TitleBar -->
        <RowDefinition Height="*" />      <!-- NavigationView -->
    </Grid.RowDefinitions>

    <TitleBar
        x:Name="AppTitleBar"
        Grid.Row="0"
        Background="Transparent"
        Title="ASD"
        IsBackButtonVisible="False"
        IsPaneToggleButtonVisible="True"
        BackRequested="TitleBar_BackRequested"
        PaneToggleRequested="TitleBar_PaneToggleRequested">
        <AutoSuggestBox
            x:Name="SearchBox"
            PlaceholderText="Search tools  (Ctrl+K)"
            QueryIcon="Find"
            MinWidth="420"
            MaxWidth="760"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            TextChanged="SearchBox_TextChanged"
            GotFocus="SearchBox_GotFocus"
            QuerySubmitted="SearchBox_QuerySubmitted" />
    </TitleBar>

    <NavigationView
        x:Name="RootNav"
        Grid.Row="1"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneOpen="False"
        PaneDisplayMode="Left"
        ItemInvoked="RootNav_ItemInvoked"
        Loaded="RootNav_Loaded"
        OpenPaneLength="260"
        CompactPaneLength="48"
        Background="Transparent"
        IsPaneToggleButtonVisible="False"
        IsTitleBarAutoPaddingEnabled="False"
        AlwaysShowHeader="False"
        CompactModeThresholdWidth="0"
        ExpandedModeThresholdWidth="10000">

        <!-- Top navigation: 7 tools + "More" = 8 items -->
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Image → ICO" Tag="ico" ToolTipService.ToolTip="Convert any image (even SVG) to icon.ico">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE91B;" FontSize="16" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Encode / Decode" Tag="encode" ToolTipService.ToolTip="Base64, URL, Hex, ROT13">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8C8;" FontSize="16" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Encrypt / Decrypt" Tag="crypto" ToolTipService.ToolTip="AES encryption">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;" FontSize="16" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Hash / HMAC" Tag="hash" ToolTipService.ToolTip="MD5, SHA, HMAC, file hashes">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE73E;" FontSize="16" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="JSON Toolkit" Tag="json" ToolTipService.ToolTip="Format, validate, JSONPath, YAML, CSV">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE943;" FontSize="16" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="JWT Decoder" Tag="jwt" ToolTipService.ToolTip="Decode, verify and sign tokens">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE192;" FontSize="16" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Regex Tester" Tag="regex" ToolTipService.ToolTip="Live matches, groups, replace, explain">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" FontSize="16" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="More" Tag="more" ToolTipService.ToolTip="Image converter, process tracker, diff, timestamp, generators, cron, converters, URL, formatters, cURL, text tools">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE712;" FontSize="16" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Search (Ctrl+K)" Tag="search" SelectsOnInvoked="False" ToolTipService.ToolTip="Jump to any tool (Ctrl+K)">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" FontSize="16" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="UpdatesNavItem" Content="Updates" Tag="updates" SelectsOnInvoked="False" ToolTipService.ToolTip="Check for updates">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE777;" FontSize="16" /></NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge x:Name="UpdatesBadge" Style="{StaticResource AttentionDotInfoBadgeStyle}" Visibility="Collapsed" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>
            <NavigationViewItem Content="Settings" Tag="settings" ToolTipService.ToolTip="Settings">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" FontSize="16" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <InfoBar x:Name="ClipBar" Grid.Row="0" IsOpen="False" Severity="Informational" Margin="12,8,12,0"/>
            <ContentControl x:Name="ContentHost" Grid.Row="1"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False"/>
        </Grid>
    </NavigationView>
    </Grid>
</Window>
