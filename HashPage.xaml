<Page
    x:Class="ASD.HashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid Padding="32" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Hash" FontSize="26" FontWeight="Bold"/>

        <TextBox x:Name="InputBox" Grid.Row="1" PlaceholderText="Enter text to hash..."
                 AcceptsReturn="True" TextWrapping="Wrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 TextChanged="OnInputChanged"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <Button Content="Clear" Click="OnClearClick"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="MD5" Width="70" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox x:Name="Md5Box" IsReadOnly="True" Width="560" FontFamily="Consolas"/>
                <Button Content="Copy" Click="OnCopyClick" Tag="Md5Box"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="SHA-1" Width="70" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox x:Name="Sha1Box" IsReadOnly="True" Width="560" FontFamily="Consolas"/>
                <Button Content="Copy" Click="OnCopyClick" Tag="Sha1Box"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="SHA-256" Width="70" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox x:Name="Sha256Box" IsReadOnly="True" Width="560" FontFamily="Consolas"/>
                <Button Content="Copy" Click="OnCopyClick" Tag="Sha256Box"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="SHA-512" Width="70" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox x:Name="Sha512Box" IsReadOnly="True" Width="560" FontFamily="Consolas"/>
                <Button Content="Copy" Click="OnCopyClick" Tag="Sha512Box"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
